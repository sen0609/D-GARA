        <activity android:name=".CookieConsentActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Dialog.Obstacle" />
        <activity
            android:name=".ProgressActivity"
            android:theme="@style/Theme.App.Dialog.Obstacle"
            android:exported="true"
